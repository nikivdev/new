# Jazz sync (client)
VITE_JAZZ_SYNC_SERVER=wss://cloud.jazz.tools/?key=jazz_cloud_demo
# Optional alternative: only set this if you want to build the sync server URL from a key
VITE_JAZZ_API_KEY=

# Jazz sync (server)
JAZZ_WORKER_ACCOUNT=
JAZZ_WORKER_SECRET=
# Optional: override the sync server for server-side operations
JAZZ_SYNC_SERVER=
# Optional: only used when JAZZ_SYNC_SERVER is unset
JAZZ_API_KEY=

# Optional: OpenRouter for AI chat responses (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: Use an OpenAI-compatible proxy server (e.g. https://api.starter.app).
# If set, the server-side chat route will try this first before falling back.
AI_SERVER_URL=
AI_SERVER_TOKEN=
AI_SERVER_MODEL=

# Optional: Polar billing
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
POLAR_REFILL_PRODUCT_ID=
POLAR_API_URL=http://127.0.0.1:8000

# Optional: Gemini for canvas image generation
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional: OpenAI images
OPENAI_API_KEY=

# Optional: Z-Image inpainting (Hugging Face)
HF_TOKEN=
HUGGING_FACE_API_KEY=

# Optional: External context API (for agentic browser)
CONTEXT_API_KEY=

# Optional: Zerg sync ingest token
ZERG_SYNC_TOKEN=

# Optional: Scrape service (website context)
SCRAPE_SERVICE_URL=
SCRAPE_SERVICE_TOKEN=

# Optional: Clawdbot dashboard URL (for sidebar integration)
VITE_CLAWDBOT_DASHBOARD_URL=

# ===========================================
# PRODUCTION DEPLOYMENT (Cloudflare Workers)
# ===========================================
# Set these as secrets in Cloudflare:
#   wrangler secret put JAZZ_WORKER_ACCOUNT
#   wrangler secret put JAZZ_WORKER_SECRET
#   wrangler secret put JAZZ_SYNC_SERVER
#   wrangler secret put JAZZ_API_KEY
#   wrangler secret put OPENROUTER_API_KEY
#   wrangler secret put POLAR_ACCESS_TOKEN
#   wrangler secret put POLAR_WEBHOOK_SECRET
#   wrangler secret put POLAR_PRO_PRODUCT_ID
#   wrangler secret put POLAR_REFILL_PRODUCT_ID
#   wrangler secret put POLAR_API_URL
#   wrangler secret put OPENAI_API_KEY
#   wrangler secret put HF_TOKEN
#   wrangler secret put HUGGING_FACE_API_KEY
#
# Or set public vars:
#   wrangler vars set VITE_JAZZ_SYNC_SERVER wss://cloud.jazz.tools/?key=your-key
